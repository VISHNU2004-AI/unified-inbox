# ==============================================================================
# Unified Inbox SaaS - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

# Database Connection (Default: SQLite for local zero-config persistence)
# For local dev:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/unified_inbox?schema=public
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/unified_inbox?schema=public"

# Authentication & Session Security
JWT_SECRET="unified_inbox_jwt_super_secret_key_2026_dev"
JWT_EXPIRES_IN="7d"

# AES-256-GCM Token Encryption Key (For securing customer Meta access tokens in DB)
ENCRYPTION_KEY="unified_inbox_aes_256_gcm_token_encryption_key_2026_dev"

# Official Meta Cloud Integration (WhatsApp Business Cloud API, Instagram Graph API, Facebook Messenger)
# Create a Meta Developer App at https://developers.facebook.com
META_APP_ID=2047013222842068
META_APP_SECRET=899700f3038eb89375767a347e8bd785
META_WEBHOOK_VERIFY_TOKEN="unified_inbox_meta_verify_token_secure"
# Public HTTPS URL configured in the Meta Developer dashboard, for example:
# META_WEBHOOK_URL="https://your-public-domain.example/api/webhooks/meta"
META_OAUTH_REDIRECT_URI="https://unified-inbox-azure.vercel.app/api/channels/meta/callback"
META_GRAPH_API_VERSION="v21.0"

# AI Multilingual Grounding Engine (Google Gemini 2.5 Flash / Smart Heuristic RAG)
GEMINI_API_KEY=""

# Stripe SaaS Billing & Subscriptions
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
