// Production PostgreSQL Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  AGENT
  SUPERADMIN
}

enum ChannelPlatform {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  LIVECHAT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SenderType {
  CUSTOMER
  AGENT
  AI_BOT
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  passwordHash   String
  name           String
  role           String            @default("AGENT")
  avatarUrl      String?
  emailVerified  Boolean           @default(false)
  isSuspended    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  memberships    WorkspaceMember[]
  assignments    ConversationAssignment[]
  internalNotes  InternalNote[]
  auditLogs      AuditLog[]
}

model Workspace {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  logoUrl        String?
  ownerId        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  members        WorkspaceMember[]
  accounts       ConnectedAccount[]
  customers      Customer[]
  conversations  Conversation[]
  messages       Message[]
  internalNotes  InternalNote[]
  businessProfile BusinessProfile?
  documents      BusinessKnowledgeDocument[]
  knowledgeChunks BusinessKnowledgeChunk[]
  products       Product[]
  services       Service[]
  aiConfig       AIConfiguration?
  aiLogs         AIMessageLog[]
  subscriptions  Subscription[]
  payments       Payment[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("AGENT")
  joinedAt    DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model ConnectedAccount {
  id                   String    @id @default(uuid())
  workspaceId          String
  platform             String
  accountName          String
  accountId            String
  externalAccountId    String?
  accountUsername      String?
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  status               String    @default("NOT_CONNECTED")
  errorMessage         String?
  metadata             String?
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId])
  @@index([platform])
  @@index([accountId])
}

model Customer {
  id          String         @id @default(uuid())
  workspaceId String
  externalId  String
  name        String
  handle      String?
  avatarUrl   String?
  email       String?
  phone       String?
  tags        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([email])
  @@index([phone])
}

model Conversation {
  id                  String             @id @default(uuid())
  workspaceId         String
  customerId          String
  channel             String
  status              String             @default("OPEN")
  priority            String             @default("NORMAL")
  unreadCount         Int                @default(0)
  lastMessageContent  String?
  lastMessageAt       DateTime           @default(now())
  assignedUserId      String?
  
  needsHumanReview    Boolean            @default(false)
  pendingDraftReply   String?
  escalationReason    String?
  lastSentiment       String?
  lastIntent          String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages            Message[]
  assignments         ConversationAssignment[]
  internalNotes       InternalNote[]
  aiLogs              AIMessageLog[]

  @@index([workspaceId])
  @@index([channel])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id                String       @id @default(uuid())
  workspaceId       String
  conversationId    String
  channel           String
  externalMessageId String?
  senderType        String
  senderName        String
  senderExternalId  String?
  content           String
  messageType       String       @default("TEXT")
  direction         String
  status            String       @default("SENT")
  isAiGenerated     Boolean      @default(false)
  aiConfidence      Float?
  aiIntent          String?
  rawPayload        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([externalMessageId])
}

model ConversationAssignment {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  assignedAt     DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
}

model InternalNote {
  id             String       @id @default(uuid())
  workspaceId    String
  conversationId String
  authorId       String
  content        String
  createdAt      DateTime     @default(now())

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
}

model BusinessProfile {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  businessName        String
  description         String?
  industry            String?
  location            String?
  contactEmail        String?
  contactPhone        String?
  businessHours       String?
  website             String?
  socialLinks         String?
  faqs                String?
  supportInstructions String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BusinessKnowledgeDocument {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  sourceType  String
  rawContent  String
  fileType    String?
  fileUrl     String?
  status      String    @default("PROCESSED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks      BusinessKnowledgeChunk[]

  @@index([workspaceId])
}

model BusinessKnowledgeChunk {
  id          String    @id @default(uuid())
  workspaceId String
  documentId  String
  chunkText   String
  keywords    String?
  embedding   String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    BusinessKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([documentId])
}

model Product {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  price        Float
  category     String?
  availability Boolean   @default(true)
  features     String?
  terms        String?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Service {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  price        Float
  duration     String?
  category     String?
  availability Boolean   @default(true)
  features     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AIConfiguration {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  autoReplyEnabled    Boolean   @default(true)
  humanReviewEnabled  Boolean   @default(false)
  personality         String    @default("Professional, warm, and helpful")
  businessTone        String    @default("Friendly yet professional")
  defaultLanguage     String    @default("auto")
  greetingMessage     String?   @default("Hello! Welcome to our business. How may I assist you today?")
  fallbackMessage     String    @default("I apologize, but I don't have that information right now. Please wait a moment while our team member assists you.")
  businessHoursBehavior String  @default("ALWAYS_REPLY")
  escalationRules     String?
  responseLength      String    @default("CONCISE")
  channelSettings     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AIMessageLog {
  id                 String       @id @default(uuid())
  workspaceId        String
  conversationId     String
  incomingText       String
  suggestedReply     String
  intent             String?
  sentiment          String?
  confidence         Float?
  decision           String
  detectedLanguage   String?
  latencyMs          Int?
  rawModelResponse   String?
  createdAt          DateTime     @default(now())

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
}

model Subscription {
  id                   String    @id @default(uuid())
  workspaceId          String
  plan                 String    @default("STARTER")
  status               String    @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Payment {
  id                   String    @id @default(uuid())
  workspaceId          String
  amount               Float
  currency             String    @default("usd")
  status               String    @default("SUCCEEDED")
  stripePaymentIntentId String?
  createdAt            DateTime  @default(now())

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  content     String
  type        String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  platform    String
  eventType   String?
  payload     String
  status      String    @default("PROCESSED")
  errorMessage String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([platform])
  @@index([status])
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}
